# ══════════════════════════════════════════════════════════════════
#  XDTV.fans — API
#  cp .env.example .env   i uzupełnij pola WPISZ_
# ══════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=4000

DATABASE_URL="postgresql://xdtv:WPISZ_HASLO_BAZY@127.0.0.1:5432/xdtv?schema=public"
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

JWT_SECRET="WPISZ_LOSOWY_SEKRET"
JWT_EXPIRES_IN=30d
SESSION_SECRET="WPISZ_LOSOWY_SEKRET"
# Ciasteczko panelu AdminJS (/admin)
ADMIN_COOKIE_SECRET="WPISZ_LOSOWY_SEKRET"

CORS_ORIGIN="https://xdtv.fans,http://localhost:3000"
APP_URL="https://xdtv.fans"
FRONTEND_URL="https://xdtv.fans"

# Konto administratora zakładane przez `npm run seed`
SEED_ADMIN_EMAIL="admin@xdtv.fans"
SEED_ADMIN_PASSWORD="WPISZ_HASLO_ADMINA"

# Poczta (bez SMTP_HOST maile idą do logu)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="XDTV <noreply@xdtv.fans>"

# ── Platformy i logowanie zewnętrzne ────────────────────────────────────
# Puste pole = dana platforma / przycisk logowania wyłączone.
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
YOUTUBE_API_KEY=""
YOUTUBE_UPLOAD_REFRESH_TOKEN=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
KICK_CLIENT_ID=""
KICK_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# ── Stripe ──────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_TIER1=""
STRIPE_PRICE_TIER2=""
STRIPE_PRICE_TIER3=""

# Tłumaczenia przez własną instancję LibreTranslate (opcjonalne)
LIBRETRANSLATE_URL="http://localhost:5000"
