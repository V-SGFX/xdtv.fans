generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────

enum UserRole {
  USER
  STREAMER
  MODERATOR
  ADMIN
}

enum PostType {
  TEXT
  LINK
  IMAGE
  VIDEO
  CLIP
  POLL
  AMA
}

enum ChannelType {
  PUBLIC
  PRIVATE
  PREMIUM
}

enum ChannelScope {
  GLOBAL
  STREAMER
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum NewsSource {
  RSS
  SCRAPER
  MANUAL
}

/// Editorial bucket a feed and its articles belong to.
enum NewsCategory {
  DRAMA      /// conflicts, controversies, callouts
  STREAMERS  /// people: bans, returns, milestones
  EVENTS     /// tournaments, esports, announcements
  GAMING     /// releases, patches, general games press
}

enum VoteType {
  UP
  DOWN
}

// ─── USERS ────────────────────────────────────────────────

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  username      String    @unique
  passwordHash  String?   @map("password_hash")  // nullable for OAuth-only users
  displayName   String?   @map("display_name")

  // OAuth platform IDs
  twitchId      String?   @unique @map("twitch_id")
  kickId        String?   @unique @map("kick_id")
  youtubeId     String?   @unique @map("youtube_id")
  tiktokId      String?   @unique @map("tiktok_id")
  discordId     String?   @unique @map("discord_id")
  avatarUrl     String?   @map("avatar_url")
  role          UserRole  @default(USER)
  isActive      Boolean   @default(true) @map("is_active")

  // Email verification
  isEmailVerified     Boolean   @default(false) @map("is_email_verified")
  emailVerifyToken    String?   @map("email_verify_token")

  // Password reset
  passwordResetToken  String?   @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires")

  lastActiveAt  DateTime? @map("last_active_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  streamerProfile StreamerProfile?
  posts           Post[]
  messages        Message[]
  follows         Follow[]
  subscriptions   Subscription[]
  comments        Comment[]
  votes           Vote[]
  notifications   Notification[] @relation("UserNotifications")
  actedNotifications Notification[] @relation("NotificationActor")
  reports         Report[]       @relation("UserReports")
  resolvedReports Report[]       @relation("ReportResolver")
  messageReactions MessageReaction[]
  postReactions   PostReaction[]
  battleVotes     BattleVote[]
  channelMutes    ChannelMute[]   @relation("MutedUser")
  channelMutesBy  ChannelMute[]   @relation("MutedByUser")
  channelBans     ChannelBan[]    @relation("BannedUser")
  channelBansBy   ChannelBan[]    @relation("BannedByUser")
  channelMods     ChannelModerator[]

  communitiesCreated  Community[]          @relation("CommunityCreator")
  communityMembers    CommunityMember[]
  communityMods       CommunityModerator[]
  modNominationsMade  CommunityModerator[] @relation("ModeratorNominatedBy")
  modApprovalsMade    CommunityModerator[] @relation("ModeratorApprovedBy")
  communityBans       CommunityBan[]       @relation("CommunityBannedUser")
  communityBansBy     CommunityBan[]       @relation("CommunityBannedByUser")
  preferences         UserPreference?
  pollVotes           PollVote[]
  amaQuestions        AmaQuestion[]
  amaAnswers          AmaAnswer[]

  // Engagement system
  xp                  UserXp?
  badges              UserBadge[]
  streak              UserStreak?
  xpTransactions      XpTransaction[]
  dailyChallenges     UserDailyChallenge[]

  // Hot Takes
  hotTakes            HotTake[]     @relation("HotTakeAuthor")
  hotTakeVotes        HotTakeVote[] @relation("HotTakeVoter")

  // Predictions
  predictionsCreated  Prediction[]      @relation("PredictionCreator")
  predictionBets      PredictionBet[]   @relation("PredictionBettor")

  // Power Rankings
  rankingVotes        RankingVote[]     @relation("RankingVoter")

  // Cosmetics
  cosmetics           UserCosmetic[]    @relation("UserCosmetics")

  // Admin
  adminActionLogs     AdminActionLog[]

  @@index([role])
  @@index([lastActiveAt])
  @@index([createdAt])
  @@map("users")
}

// ─── USER PREFERENCES (feed personalization signals) ──────

model UserPreference {
  id                  Int      @id @default(autoincrement())
  userId              Int      @unique @map("user_id")
  viewedStreamerIds    Int[]    @default([]) @map("viewed_streamer_ids")   // streamerProfileIds the user viewed
  likedTagSlugs       String[] @default([]) @map("liked_tag_slugs")       // tag slugs the user engaged with
  updatedAt           DateTime @updatedAt @map("updated_at")

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ─── STREAMER PROFILES ────────────────────────────────────

model StreamerProfile {
  id            Int       @id @default(autoincrement())
  userId        Int?      @unique @map("user_id")
  slug          String    @unique
  name          String
  bio           String?
  avatarUrl     String?   @map("avatar_url")
  bannerUrl     String?   @map("banner_url")
  twitchUrl     String?   @map("twitch_url")
  youtubeUrl    String?   @map("youtube_url")
  kickUrl       String?   @map("kick_url")
  twitterUrl    String?   @map("twitter_url")

  // Platform IDs for API sync
  twitchId      String?   @unique @map("twitch_id")
  kickId        String?   @unique @map("kick_id")
  youtubeId     String?   @unique @map("youtube_id")
  tiktokId      String?   @unique @map("tiktok_id")

  isClaimed     Boolean   @default(false) @map("is_claimed")
  isVerified    Boolean   @default(false) @map("is_verified")
  isLive        Boolean   @default(false) @map("is_live")
  chatEnabled   Boolean   @default(false) @map("chat_enabled")
  viewCount     Int       @default(0) @map("view_count")
  followerCount Int       @default(0) @map("follower_count")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  channels      Channel[]
  posts         Post[]    @relation("StreamerPosts")
  follows       Follow[]
  news          News[]
  subscriptions Subscription[]
  chatEmojis    ChatEmoji[]
  battles1      Battle[]    @relation("BattleStreamer1")
  battles2      Battle[]    @relation("BattleStreamer2")
  stats         StreamerStats[]
  rankingVotes  RankingVote[]
  community     Community?        @relation("StreamerCommunity")
  @@index([slug])
  @@index([name])
  @@index([twitchId])
  @@index([kickId])
  @@index([youtubeId])
  @@index([tiktokId])
  @@map("streamer_profiles")
}

// ─── STREAMER STATS (per-platform live/follower data) ─────

model StreamerStats {
  id                Int       @id @default(autoincrement())
  streamerProfileId Int       @map("streamer_profile_id")
  platform          Platform
  followers         Int       @default(0)
  isLive            Boolean   @default(false) @map("is_live")
  streamTitle       String?   @map("stream_title")
  viewerCount       Int       @default(0) @map("viewer_count")
  thumbnailUrl      String?   @map("thumbnail_url")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  streamerProfile   StreamerProfile @relation(fields: [streamerProfileId], references: [id], onDelete: Cascade)

  @@unique([streamerProfileId, platform])
  @@index([platform])
  @@index([isLive])
  @@map("streamer_stats")
}

// ─── POSTS ────────────────────────────────────────────────

model Post {
  id              Int       @id @default(autoincrement())
  authorId        Int       @map("author_id")
  streamerProfileId Int?    @map("streamer_profile_id")
  communityId     Int?      @map("community_id")
  title           String
  content         String
  type            PostType  @default(TEXT)
  isOfficial      Boolean   @default(false) @map("is_official")
  isNsfw          Boolean   @default(false) @map("is_nsfw")
  isFlagged       Boolean   @default(false) @map("is_flagged")
  imageUrl        String?   @map("image_url")
  linkUrl         String?   @map("link_url")
  videoUrl        String?   @map("video_url")
  thumbnailUrl    String?   @map("thumbnail_url")
  clipSource      ClipSource? @map("clip_source")
  externalId      String?   @map("external_id")
  duration        Int?      // seconds (for clips)
  viewCount       Int       @default(0) @map("view_count")
  upvotes         Int       @default(0)
  downvotes       Int       @default(0)
  commentCount    Int       @default(0) @map("comment_count")
  hotScore        Float     @default(0) @map("hot_score")
  isPinned        Boolean   @default(false) @map("is_pinned")
  isDeleted       Boolean   @default(false) @map("is_deleted")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  author          User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  streamerProfile StreamerProfile? @relation("StreamerPosts", fields: [streamerProfileId], references: [id], onDelete: SetNull)
  community       Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)
  comments        Comment[]
  votes           Vote[]
  tags            PostTag[]
  reactions       PostReaction[]
  images          PostImage[]
  poll            Poll?
  amaSession      AmaSession?
  follows         Follow[]

  @@index([authorId])
  @@index([streamerProfileId])
  @@index([communityId])
  @@index([createdAt])
  @@index([type])
  @@index([isOfficial])
  @@index([hotScore])
  @@map("posts")
}

// ─── POST IMAGES ──────────────────────────────────────────

model PostImage {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_images")
}

// ─── POLLS ────────────────────────────────────────────────

model Poll {
  id        Int          @id @default(autoincrement())
  postId    Int          @unique @map("post_id")
  endsAt    DateTime?    @map("ends_at")
  createdAt DateTime     @default(now()) @map("created_at")

  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  options   PollOption[]

  @@map("polls")
}

model PollOption {
  id        Int        @id @default(autoincrement())
  pollId    Int        @map("poll_id")
  text      String
  order     Int        @default(0)
  voteCount Int        @default(0) @map("vote_count")

  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  id        Int        @id @default(autoincrement())
  optionId  Int        @map("option_id")
  userId    Int        @map("user_id")
  createdAt DateTime   @default(now()) @map("created_at")

  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([userId])
  @@map("poll_votes")
}

// ─── AMA (Ask Me Anything) ────────────────────────────────

model AmaSession {
  id          Int           @id @default(autoincrement())
  postId      Int           @unique @map("post_id")
  endsAt      DateTime      @map("ends_at")
  isOpen      Boolean       @default(true) @map("is_open")
  createdAt   DateTime      @default(now()) @map("created_at")

  post        Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  questions   AmaQuestion[]

  @@map("ama_sessions")
}

model AmaQuestion {
  id           Int          @id @default(autoincrement())
  sessionId    Int          @map("session_id")
  authorId     Int          @map("author_id")
  content      String
  upvotes      Int          @default(0)
  isAnswered   Boolean      @default(false) @map("is_answered")
  createdAt    DateTime     @default(now()) @map("created_at")

  session      AmaSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  answer       AmaAnswer?

  @@index([sessionId])
  @@index([authorId])
  @@map("ama_questions")
}

model AmaAnswer {
  id           Int          @id @default(autoincrement())
  questionId   Int          @unique @map("question_id")
  authorId     Int          @map("author_id")
  content      String
  createdAt    DateTime     @default(now()) @map("created_at")

  question     AmaQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("ama_answers")
}

// ─── POST REACTIONS (emoji on posts) ──────────────────────

model PostReaction {
  id          Int       @id @default(autoincrement())
  postId      Int       @map("post_id")
  userId      Int       @map("user_id")
  emoji       String
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, emoji])
  @@index([postId])
  @@map("post_reactions")
}

// ─── TAGS (replace forum categories) ──────────────────────

/// Domain dimension a tag belongs to.
///
/// The tag table is a single flat namespace that in practice carries several
/// orthogonal dimensions at once — `fortnite` (a game), `english` (a language)
/// and `clip` (a format) were all stored identically, which left the UI unable
/// to tell them apart and forced it to render every tag as a plain #hashtag.
///
/// This is a logical layer only: no separate Game table exists, so a "game" is
/// a Tag with type GAME. Extracting a real Game entity later stays possible.
enum TagType {
  GAME      /// A title: fortnite, cs2, elden-ring
  CATEGORY  /// A content category: just-chatting, irl, music, esports
  LANGUAGE  /// Broadcast language: english, russian, spanish
  FORMAT    /// Source or medium: clip, twitch, youtube, shorts
  TOPIC     /// Free-form theme or mood: humor, drama, speedrun (default)
}

model Tag {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  color       String?
  type        TagType   @default(TOPIC)
  postCount   Int       @default(0) @map("post_count")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  posts       PostTag[]
  follows     Follow[]

  @@index([slug])
  @@index([postCount])
  @@index([type])
  @@map("tags")
}

model PostTag {
  postId    Int     @map("post_id")
  tagId     Int     @map("tag_id")

  // Relations
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

// ─── CHANNELS (global + streamer, Discord-style) ─────────

model Channel {
  id                Int          @id @default(autoincrement())
  scope             ChannelScope @default(STREAMER)
  streamerProfileId Int?         @map("streamer_profile_id")
  name              String
  slug              String
  description       String?
  type              ChannelType  @default(PUBLIC)
  sortOrder         Int          @default(0) @map("sort_order")
  isActive          Boolean      @default(true) @map("is_active")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  // Relations
  streamerProfile   StreamerProfile? @relation(fields: [streamerProfileId], references: [id], onDelete: Cascade)
  messages          Message[]
  mutes             ChannelMute[]
  bans              ChannelBan[]
  moderators        ChannelModerator[]

  @@unique([scope, streamerProfileId, slug])
  @@index([scope])
  @@index([streamerProfileId])
  @@map("channels")
}

// ─── MESSAGES (chat) ──────────────────────────────────────

model Message {
  id          Int       @id @default(autoincrement())
  channelId   Int       @map("channel_id")
  authorId    Int       @map("author_id")
  content     String
  isPinned    Boolean   @default(false) @map("is_pinned")
  isDeleted   Boolean   @default(false) @map("is_deleted")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions   MessageReaction[]

  @@index([channelId, createdAt])
  @@index([channelId, isPinned])
  @@index([authorId])
  @@index([createdAt])
  @@map("messages")
}

// ─── MESSAGE REACTIONS ────────────────────────────────────

model MessageReaction {
  id          Int       @id @default(autoincrement())
  messageId   Int       @map("message_id")
  userId      Int       @map("user_id")
  emoji       String
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

// ─── FOLLOWS ──────────────────────────────────────────────

/// A follow edge. Targets either a streamer or a tag (a game, a category, a
/// language) — exactly one of the two is set.
///
/// Extended rather than duplicated into a second table: the semantics are
/// identical ("show me more of this"), the Following feed reads them together,
/// and a TagFollow model would mean two queries and two toggle endpoints for
/// one concept.
model Follow {
  id                Int       @id @default(autoincrement())
  userId            Int       @map("user_id")
  streamerProfileId Int?      @map("streamer_profile_id")
  tagId             Int?      @map("tag_id")
  postId            Int?      @map("post_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  // Relations
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  streamerProfile   StreamerProfile?  @relation(fields: [streamerProfileId], references: [id], onDelete: Cascade)
  tag               Tag?              @relation(fields: [tagId], references: [id], onDelete: Cascade)
  post              Post?             @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, streamerProfileId])
  @@unique([userId, tagId])
  @@unique([userId, postId])
  @@index([streamerProfileId])
  @@index([tagId])
  @@index([postId])
  @@map("follows")
}

// ─── NEWS ─────────────────────────────────────────────────

model RssSource {
  id            Int       @id @default(autoincrement())
  name          String
  url           String    @unique
  language      String    @default("en")
  /// Everything this feed produces lands in this bucket. Feed-level rather
  /// than per-article because publishers already split by section, and
  /// classifying headlines by keyword guesses badly.
  category      NewsCategory @default(GAMING)
  isActive      Boolean   @default(true) @map("is_active")
  lastScrapedAt DateTime? @map("last_scraped_at")
  articlesCount Int       @default(0) @map("articles_count")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("rss_sources")
}

model News {
  id                Int         @id @default(autoincrement())
  streamerProfileId Int?        @map("streamer_profile_id")
  /// Polish. The scraper has always written the translated text here and
  /// 1,466 existing rows are Polish, so this stays the PL field.
  title             String
  summary           String?
  /// English. For an English-language feed this is the untouched original, so
  /// storing both languages costs one translation call rather than two.
  titleEn           String?     @map("title_en")
  summaryEn         String?     @map("summary_en")
  /// English body. Tłumaczony razem z tytułem i zajawką, jednym przebiegiem
  /// scrapera. Artykuły sprzed tej kolumny go nie mają i przy angielskim
  /// interfejsie pokazują treść oryginalną — lepszą niż pusty ekran.
  contentEn         String?     @map("content_en")
  category          NewsCategory @default(GAMING)
  commentCount      Int         @default(0) @map("comment_count")
  content           String?
  sourceUrl         String      @unique @map("source_url")
  source            NewsSource  @default(RSS)
  sourceName        String?     @map("source_name")
  imageUrl          String?     @map("image_url")
  isPublished       Boolean     @default(true) @map("is_published")
  publishedAt       DateTime?   @map("published_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  // Relations
  streamerProfile   StreamerProfile? @relation(fields: [streamerProfileId], references: [id], onDelete: SetNull)
  comments          Comment[]

  @@index([streamerProfileId])
  @@index([createdAt])
  @@index([publishedAt])
  @@index([category])
  @@map("news")
}

// ─── SUBSCRIPTIONS (future monetization) ──────────────────

model Subscription {
  id                Int                @id @default(autoincrement())
  userId            Int                @map("user_id")
  streamerProfileId Int                @map("streamer_profile_id")
  status            SubscriptionStatus @default(ACTIVE)
  tier              Int                @default(1)
  expiresAt         DateTime?          @map("expires_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  // Relations
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  streamerProfile   StreamerProfile   @relation(fields: [streamerProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, streamerProfileId])
  @@index([status])
  @@index([expiresAt])
  @@map("subscriptions")
}

// ─── COMMENTS (threaded discussions on posts) ─────────────

/// A comment on a post or on a news article — exactly one of the two.
///
/// News was the only content type users could not discuss, because a comment
/// could only point at a Post. Rather than mint a shadow Post per article and
/// duplicate its title and summary, the target is nullable on both sides.
model Comment {
  id          Int       @id @default(autoincrement())
  postId      Int?      @map("post_id")
  newsId      Int?      @map("news_id")
  authorId    Int       @map("author_id")
  parentId    Int?      @map("parent_id")
  content     String
  depth       Int       @default(0) @db.SmallInt
  path        String    @default("")
  upvotes     Int       @default(0)
  downvotes   Int       @default(0)
  isDeleted   Boolean   @default(false) @map("is_deleted")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  post        Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  news        News?     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent      Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[] @relation("CommentReplies")

  votes       Vote[]

  @@index([postId, createdAt])
  @@index([newsId])
  @@index([postId, path])
  @@index([authorId])
  @@index([parentId])
  @@map("comments")
}

// ─── VOTES (per-user voting on posts & comments) ──────────

model Vote {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  postId      Int?      @map("post_id")
  commentId   Int?      @map("comment_id")
  type        VoteType
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post        Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment     Comment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@index([postId])
  @@index([commentId])
  @@map("votes")
}

// ─── NOTIFICATIONS ────────────────────────────────────────

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum ReportTargetType {
  POST
  COMMENT
  USER
}

