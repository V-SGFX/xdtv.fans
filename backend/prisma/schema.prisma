/// Blok reklamowy.
///
/// Kod wstawia administrator w panelu i jest to **surowy HTML wykonywany
/// w przeglądarce odwiedzającego** — inaczej nie da się osadzić AdSense,
/// bo jego snippet to znacznik <script>. Dlatego zapis do tej tabeli jest
/// dostępny wyłącznie z panelu administracyjnego, a punkt końcowy API
/// zwraca kod tylko dla bloków aktywnych. Kto może tu pisać, ten i tak
/// może zrobić z serwisem wszystko.
///
/// `key` jest kontraktem między bazą a kodem strony: komponent <AdSlot>
/// szuka bloku po tym kluczu. Nowy klucz w bazie nie pojawi się nigdzie,
/// dopóki ktoś nie wstawi komponentu w widoku — i odwrotnie, komponent bez
/// pasującego wiersza po prostu nic nie rysuje.
model AdSlot {
  id          Int      @id @default(autoincrement())
  /// Identyfikator używany w kodzie strony, np. "home-top".
  key         String   @unique
  /// Nazwa dla człowieka w panelu.
  name        String
  /// Gdzie dokładnie ten blok się pokazuje — opis dla administratora.
  description String?
  /// Kod od dostawcy reklam (AdSense, sieć afiliacyjna, własny baner).
  code        String?
  /// Wyłączony blok nie trafia do API w ogóle.
  isActive    Boolean  @default(false) @map("is_active")
  /// Kolejność w panelu; nie wpływa na wygląd strony.
  position    Int      @default(0)

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("ad_slots")
}
