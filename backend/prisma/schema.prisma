/// Moderator scoped to one community.
///
/// Until now this table was written once — the creator of a community got a
/// row — and read by nothing at all. No endpoint added or removed rows, and
/// no authorisation check consulted it, so the record granted exactly
/// nothing. The status column is what turns it into a real appointment:
/// a community owner nominates, an administrator approves, and only an
/// ACTIVE row confers the power to moderate.
model CommunityModerator {
  id            Int             @id @default(autoincrement())
  communityId   Int             @map("community_id")
  userId        Int             @map("user_id")
  status        ModeratorStatus @default(PENDING)

  /// Who put this person forward — the community owner, or an admin acting
  /// directly. Kept apart from approvedBy so "who wanted this" and "who
  /// allowed it" stay two separate questions.
  nominatedById Int?            @map("nominated_by_id")
  approvedById  Int?            @map("approved_by_id")
  approvedAt    DateTime?       @map("approved_at")
  revokedAt     DateTime?       @map("revoked_at")
  /// Why a nomination was rejected or an appointment withdrawn.
  reason        String?

  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  community     Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nominatedBy   User?     @relation("ModeratorNominatedBy", fields: [nominatedById], references: [id], onDelete: SetNull)
  approvedBy    User?     @relation("ModeratorApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([communityId, userId])
  @@index([communityId])
  @@index([userId])
  /// The admin queue reads pending nominations across every community.
  @@index([status])
  @@map("community_moderators")
}

enum ModeratorStatus {
  /// Nominated, waiting for an administrator. Grants nothing.
  PENDING
  /// Approved. This is the only status that grants moderation powers.
  ACTIVE
  /// Rejected before approval, or withdrawn afterwards. Kept rather than
  /// deleted so the history of who moderated what stays readable.
  REVOKED
}

